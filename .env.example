# Copiar como ".env". Sin nada de esto configurado, el envío de SMS queda
# simulado. Se usa Termux si está configurado; si no, SMS Gateway for Android.

# Termux (celular con `pkg install termux-api openssh`, `sshd` corriendo)
TERMUX_HOST=
TERMUX_PORT=8022
TERMUX_USER=
TERMUX_PASSWORD=

# SMS Gateway for Android (alternativa, api.sms-gate.app)
SMSGATE_USER=
SMSGATE_PASSWORD=
